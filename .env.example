# CenkorMES 后端环境配置示例
# 复制为 backend/.env 后按需修改：cp backend/env.example backend/.env
# 注意：仓库规范端口为 8000（与 vite 开发代理 / docker-compose / config 默认一致）。
#       如部署在反向代理后，可用非 80 端口；生产请通过 Nginx / 宝塔反向代理到本服务。

APP_NAME=CenkorMES
APP_ENV=dev                # dev | prod；dev 下 uvicorn 自动 --reload
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库连接（MySQL 5.7+/8.x；库名请确保与建库一致）
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/cenkormes?charset=utf8mb4
DB_ECHO=false
DB_AUTO_CREATE=true        # 首启自动按 ORM create_all 建表
DB_AUTO_SEED=true          # 首启自动创建默认管理员 admin/admin123

# JWT 密钥：生产务必改为足够长的随机串，切勿使用默认值
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256

# 对外可访问地址（用于生成分享 / 回调 / 打印链接）
PUBLIC_BASE_URL=http://localhost:8000
H5_PUBLIC_BASE_URL=http://localhost:8000

# 文件存储：local（本地磁盘）| aliyun_oss | tencent_cos | qiniu
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage

# Redis / Celery（异步任务；无 Celery 场景可留默认）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ─────────────────────────────────────────────────────────
# Docker Compose 一键部署的对外端口覆盖（可选项，复制本文件为仓库根 .env 后使用）
# 默认：后端 API=8000、管理后台=8080、员工 H5=8081。
# 若宿主对应端口被其它进程占用，可在此改成空闲端口（容器内部端口不变，互不影响）。
# ─────────────────────────────────────────────────────────
# APP_PORT=8000          # 后端 API 对外端口
# WEB_ADMIN_PORT=8080    # 管理后台对外端口
# WEB_H5_PORT=8081       # 员工 H5 对外端口
# PUBLIC_BASE_URL=http://localhost:8080