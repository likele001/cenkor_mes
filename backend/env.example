# CenkorMES 后端环境配置示例
# 复制为 backend/.env 后按需修改：cp backend/env.example backend/.env
# 注意：仓库规范端口为 8000（与 vite 开发代理 / docker-compose / config 默认一致）。
#       如部署在反向代理后，可用非 80 端口；生产请通过 Nginx / 宝塔反向代理到本服务。

APP_NAME=CenkorMES
APP_ENV=dev                # dev | prod；dev 下 uvicorn 自动 --reload
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库连接（MySQL 5.7+/8.x；库名请确保与建库一致）
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/cenkormes?charset=utf8mb4
DB_ECHO=false
DB_AUTO_CREATE=true        # 首启自动按 ORM create_all 建表
DB_AUTO_SEED=true          # 首启自动创建默认管理员 admin/admin123

# JWT 密钥：生产务必改为 ≥32 位的强随机串，切勿使用默认值。
# 生产（APP_ENV=prod）启动时若密钥仍为默认/过短将直接拒绝启动（fail-fast）。
# 生成示例：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_SECRET_MIN_LENGTH=32   # 生产环境 JWT 密钥最小长度

# ── 安全基线 ──
# 用户密码最小长度（内置种子账号 admin/admin123、演示账号 123456 均为 6 位，勿再调低）
PASSWORD_MIN_LENGTH=6
# CORS 白名单：逗号分隔的完整来源，如 https://admin.example.com,https://h5.example.com
# 留空则不开 CORS（推荐经 Nginx 同域反向代理，前端无需跨域）
CORS_ORIGINS=
# 允许的 Host 白名单：逗号分隔，如 example.com,admin.example.com
# 留空不启用 Host 校验；生产建议固定以防范 Host 头注入
TRUSTED_HOSTS=
# 登录失败限流：同一 IP 在窗口内失败达阈值即临时锁定（Redis 优先，无 Redis 降级单实例内存）
LOGIN_MAX_FAILURES=10          # ≤0 表示关闭限流
LOGIN_FAIL_WINDOW_SECONDS=300  # 失败计数滑动窗口（秒）
LOGIN_LOCKOUT_SECONDS=300      # 锁定持续时间（秒）

# 对外可访问地址（用于生成分享 / 回调 / 打印链接）
PUBLIC_BASE_URL=http://localhost:8000
H5_PUBLIC_BASE_URL=http://localhost:8000

# 文件存储：local（本地磁盘）| aliyun_oss | tencent_cos | qiniu
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage

# Redis / Celery（异步任务；无 Celery 场景可留默认）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1