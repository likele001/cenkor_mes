# CenkorMES 离线部署配置模板
#
# 由 offline-install.sh 复制为 .env 使用；也可手工 `cp .env.offline.example .env`。
# 注意：这是 docker compose 读取的**编排层**变量，与 backend/.env（应用层）
# 是两套东西，别混在一起。
#
# 端口冲突时改这里：例如宿主机 8000 已被别的服务占用，就改成 18000。

# 后端 API 对外端口（容器内固定 8000，这里是宿主机映射）
APP_PORT=8000
# 管理后台 Web
WEB_ADMIN_PORT=8080
# 员工 H5 Web
WEB_H5_PORT=8081

# 对外可访问地址：用于生成分享链接 / 回调 / 打印地址
# 部署到域名后改成 https://your-domain.com 这类真实地址
PUBLIC_BASE_URL=http://localhost:8080

# JWT 签名密钥 —— 必须修改为 ≥32 位强随机串
# 留空时 offline-install.sh 会自动生成一个并写回本文件
# 生成命令：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
