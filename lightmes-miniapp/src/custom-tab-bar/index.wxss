.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
}
.tab-item.active {
  color: #2563eb;
}
.tab-item.center .icon {
  font-size: 44rpx;
}
.icon-wrap {
  display: inline-block;
  position: relative;
}
.icon {
  display: block;
  font-size: 36rpx;
}
.badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  padding: 0 6rpx;
  white-space: nowrap;
}
.text {
  display: block;
}
